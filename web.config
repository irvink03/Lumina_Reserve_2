<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Lumina_Reserve_2.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>

  <!--
    Validación del certificado SSL gratuito (Let's Encrypt).
    El hosting coloca un archivo sin extensión en /.well-known/acme-challenge/ y Let's Encrypt
    lo descarga por http. Sin esta sección, ASP.NET Core atiende esa ruta, responde 404 y la
    emisión o renovación del certificado falla. Aquí IIS sirve esos archivos directamente.
  -->
  <location path=".well-known">
    <system.webServer>
      <handlers>
        <remove name="aspNetCore" />
        <add name="ArchivosAcme" path="*" verb="GET,HEAD" modules="StaticFileModule" resourceType="Either" requireAccess="Read" />
      </handlers>
      <staticContent>
        <remove fileExtension="." />
        <mimeMap fileExtension="." mimeType="text/plain" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
