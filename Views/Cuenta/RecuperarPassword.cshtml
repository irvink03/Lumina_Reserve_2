@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="container mt-5 pt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="p-4 p-md-5 shadow-lg" style="background-color: #0f0f0f; border: 1px solid #2a2a2a; border-radius: 16px;">
                <div class="text-center mb-4">
                    <i class="fa-solid fa-key fs-2 mb-3" style="color: #d4af37;"></i>
                    <h3 class="fw-bold mb-2" style="color: #d4af37;">¿Olvidaste tu contraseña?</h3>
                    <p class="text-white-50 small mb-0">Escribe el correo de tu cuenta y te enviaremos un código a tu Telegram para crear una nueva.</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 mb-3">@ViewBag.Error</div>
                }

                <form asp-action="RecuperarPassword" method="post">
                    <div class="mb-4">
                        <label class="form-label text-white-50 small" for="correo">Correo electrónico</label>
                        <input type="email" id="correo" name="correo" class="form-control bg-dark text-white border-secondary" placeholder="tucorreo@email.com" autocomplete="email" required autofocus />
                    </div>

                    <button type="submit" class="btn w-100 py-2 fw-bold" style="background-color: #d4af37; color: #000; border-radius: 8px;">
                        <i class="fa-brands fa-telegram me-1"></i> Enviarme el código
                    </button>
                </form>

                <div class="p-3 mt-4 rounded" style="background-color: #161616; border: 1px solid #332d18;">
                    <h6 class="mb-2 small fw-bold" style="color: #d4af37;"><i class="fa-solid fa-circle-info"></i> Importante</h6>
                    <p class="text-white-50 small mb-0" style="font-size: 0.8rem;">
                        El código llega al Telegram que usas para iniciar sesión con <strong style="color: #d4af37;">@@LuminaReserva_bot</strong>.
                        Si nunca has iniciado sesión con el bot, no podemos enviarte el código: acude a la barbería para recuperar tu cuenta.
                    </p>
                </div>

                <div class="text-center mt-4">
                    <a asp-action="Login" style="color: #d4af37;" class="text-decoration-none small"><i class="fa-solid fa-arrow-left me-1"></i> Volver a iniciar sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>
