@{
    ViewData["Title"] = "Nueva contraseña";
    var correo = ViewBag.Correo as string ?? "";
}

<div class="container mt-5 pt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="p-4 p-md-5 shadow-lg" style="background-color: #0f0f0f; border: 1px solid #2a2a2a; border-radius: 16px;">
                <div class="text-center mb-4">
                    <i class="fa-solid fa-lock-open fs-2 mb-3" style="color: #d4af37;"></i>
                    <h3 class="fw-bold mb-2" style="color: #d4af37;">Crea tu nueva contraseña</h3>
                </div>

                @if (TempData["InfoRecuperar"] != null)
                {
                    <div class="alert py-2 mb-3 small" style="background-color: #161616; border: 1px solid #332d18; color: rgba(255,255,255,.75);">
                        <i class="fa-brands fa-telegram me-1" style="color: #3aa6d8;"></i> @TempData["InfoRecuperar"]
                    </div>
                }
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 mb-3">@ViewBag.Error</div>
                }

                <form asp-action="RestablecerPassword" method="post" id="formRestablecer">
                    <div class="mb-3">
                        <label class="form-label text-white-50 small" for="correo">Correo electrónico</label>
                        <input type="email" id="correo" name="correo" value="@correo" class="form-control bg-dark text-white border-secondary" autocomplete="username" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-white-50 small" for="codigo">Código de Telegram</label>
                        <input type="text" id="codigo" name="codigo" class="form-control bg-dark text-white border-secondary" placeholder="Ej. 482913"
                               inputmode="numeric" autocomplete="one-time-code" pattern="\d{6}" maxlength="6" required autofocus />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-white-50 small" for="nuevaPassword">Nueva contraseña</label>
                        <input type="password" id="nuevaPassword" name="nuevaPassword" class="form-control bg-dark text-white border-secondary" placeholder="Mínimo 8 caracteres" minlength="8" autocomplete="new-password" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-white-50 small" for="confirmarPassword">Confirmar nueva contraseña</label>
                        <input type="password" id="confirmarPassword" name="confirmarPassword" class="form-control bg-dark text-white border-secondary" placeholder="Repite la contraseña" minlength="8" autocomplete="new-password" required />
                        <small id="avisoCoincide" class="d-none" style="color: #ff8a8d; font-size: .8rem;">Las contraseñas no coinciden.</small>
                    </div>

                    <button type="submit" class="btn w-100 py-2 fw-bold" style="background-color: #d4af37; color: #000; border-radius: 8px;">Guardar nueva contraseña</button>
                </form>

                <div class="d-flex justify-content-between mt-4 small">
                    <a asp-action="RecuperarPassword" style="color: #d4af37;" class="text-decoration-none">¿No te llegó? Pedir otro código</a>
                    <a asp-action="Login" class="text-white-50 text-decoration-none">Volver</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const nueva = document.getElementById('nuevaPassword');
            const confirmar = document.getElementById('confirmarPassword');
            const aviso = document.getElementById('avisoCoincide');
            function revisar() {
                const distinto = confirmar.value && nueva.value !== confirmar.value;
                aviso.classList.toggle('d-none', !distinto);
                confirmar.setCustomValidity(distinto ? 'Las contraseñas no coinciden.' : '');
            }
            nueva.addEventListener('input', revisar);
            confirmar.addEventListener('input', revisar);
        })();
    </script>
}
