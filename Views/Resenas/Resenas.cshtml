@{
    ViewData["Title"] = "Reseñas de Clientes";
}

<div class="container mt-5 pt-3 mb-5">
    <div class="text-center mb-5">
        <!-- TÍTULO EN DORADO -->
        <h1 class="fw-bold brand-gold display-5 mb-2">LA VOZ DE NUESTROS CLIENTES</h1>
        <p class="text-white-50">Tu opinión forja nuestra excelencia. Califica el servicio de nuestros especialistas.</p>
    </div>

    <div class="row g-4">
        <!-- Formulario Izquierda -->
        <div class="col-md-5">
            <div class="dark-card border-gold p-4">
                <h4 class="text-white fw-bold mb-4">Dejar una Reseña</h4>
                <form>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Tu Nombre</label>
                        <input type="text" class="form-control form-dark-control" placeholder="Ej. Carlos Martínez" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Selecciona a tu Barbero</label>
                        <select class="form-select form-dark-control">
                            <option>Elige un especialista...</option>
                            <option>Irvin Chavarría</option>
                            <option>Fernando Rodríguez</option>
                            <option>Diego Silva</option>
                            <option>Erick Ulises</option>
                            <option>Geovany Iván</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Calificación</label>
                        <select class="form-select form-dark-control">
                            <option>★★★★★ (5 Estrellas)</option>
                            <option>★★★★☆ (4 Estrellas)</option>
                            <option>★★★☆☆ (3 Estrellas)</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-white-50 small">Tu Experiencia</label>
                        <textarea class="form-control form-dark-control" rows="3" placeholder="¿Qué tal quedó el corte?"></textarea>
                    </div>
                    <button type="submit" class="btn btn-gold-fill w-100 fw-bold">PUBLICAR RESEÑA</button>
                </form>
            </div>
        </div>

        <!-- Lista Derecha -->
        <div class="col-md-7">
            <div class="dark-card border-gold p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="text-white fw-bold mb-0">Reseñas Recientes</h4>
                    <span class="badge bg-warning text-dark">3 Opiniones</span>
                </div>

                <div class="border-bottom border-secondary pb-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="text-white fw-bold mb-0">Alejandro G.</h6>
                        <span class="text-warning small">★★★★★</span>
                    </div>
                    <small class="text-white-50 d-block mb-2" style="font-size: 0.75rem;">Atendido por: Irvin Chavarría</small>
                    <p class="text-white-50 small mb-0">"Excelente atención y detalle en el fade. Irvin entiende perfecto lo que necesitas."</p>
                </div>

                <div class="border-bottom border-secondary pb-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="text-white fw-bold mb-0">Roberto M.</h6>
                        <span class="text-warning small">★★★★★</span>
                    </div>
                    <small class="text-white-50 d-block mb-2" style="font-size: 0.75rem;">Atendido por: Fernando Rodríguez</small>
                    <p class="text-white-50 small mb-0">"El servicio clásico con toalla caliente es otro nivel. Fernando es un profesional."</p>
                </div>

                <div>
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="text-white fw-bold mb-0">Daniel S.</h6>
                        <span class="text-warning small">★★★★★</span>
                    </div>
                    <small class="text-white-50 d-block mb-2" style="font-size: 0.75rem;">Atendido por: Erick Ulises</small>
                    <p class="text-white-50 small mb-0">"Muy buen freestyle, me hizo un diseño bastante limpio. Recomendado."</p>
                </div>
            </div>
        </div>
    </div>
</div>