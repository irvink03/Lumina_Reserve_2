@model IEnumerable<Lumina_Reserve_2.Models.Resena>
@{
    ViewData["Title"] = "Reseñas de Clientes";
    var porCalificar = ViewBag.CitasPorCalificar as List<Lumina_Reserve_2.Models.Cita> ?? new();
    var logueado = User.Identity?.IsAuthenticated == true;
    var total = Model.Count();
    var promedio = total > 0 ? Model.Average(r => r.Calificacion ?? 0) : 0;

    string Estrellas(int? n)
    {
        var v = Math.Clamp(n ?? 0, 0, 5);
        return new string('★', v) + new string('☆', 5 - v);
    }

    string NombreCorto(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "Cliente";
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length > 1 ? $"{partes[0]} {partes[1][0]}." : partes[0];
    }
}

<div class="container mt-5 pt-3 mb-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold brand-gold display-5 mb-2">LA VOZ DE NUESTROS CLIENTES</h1>
        <p class="text-white-50">Tu opinión forja nuestra excelencia. Califica el servicio de nuestros especialistas.</p>
    </div>

    @if (TempData["ExitoResena"] != null)
    {
        <div class="alert alert-success">@TempData["ExitoResena"]</div>
    }
    @if (TempData["ErrorResena"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorResena"]</div>
    }

    <div class="row g-4">
        <!-- Formulario Izquierda -->
        <div class="col-md-5">
            <div class="dark-card border-gold p-4">
                <h4 class="text-white fw-bold mb-4">Dejar una Reseña</h4>

                @if (!logueado)
                {
                    <p class="text-white-50 small mb-3">Para calificar un servicio necesitas iniciar sesión. Solo puedes reseñar citas que ya fueron completadas.</p>
                    <a asp-controller="Cuenta" asp-action="Login" class="btn btn-gold-fill w-100 fw-bold">INICIAR SESIÓN</a>
                }
                else if (porCalificar.Count == 0)
                {
                    <p class="text-white-50 small mb-3">No tienes citas completadas pendientes de calificar. Cuando terminemos tu próximo servicio podrás dejar tu opinión aquí.</p>
                    <a asp-controller="Citas" asp-action="Agendar" class="btn btn-gold-fill w-100 fw-bold">AGENDAR CITA</a>
                }
                else
                {
                    <form asp-action="GuardarResena" method="post">
                        <div class="mb-3">
                            <label class="form-label text-white-50 small" for="citaId">Cita a calificar</label>
                            <select id="citaId" name="citaId" class="form-select form-dark-control" required>
                                @foreach (var c in porCalificar)
                                {
                                    var servicios = string.Join(", ", c.Cortes.Select(x => x.Nombre));
                                    <option value="@c.CitaId">
                                        @c.FechaHora.ToString("dd/MM/yyyy HH:mm") — @(c.Empleado?.Usuario?.Nombre ?? "Barbero")@(servicios.Length > 0 ? $" ({servicios})" : "")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white-50 small" for="calificacion">Calificación</label>
                            <select id="calificacion" name="calificacion" class="form-select form-dark-control" required>
                                <option value="5">★★★★★ (5 Estrellas)</option>
                                <option value="4">★★★★☆ (4 Estrellas)</option>
                                <option value="3">★★★☆☆ (3 Estrellas)</option>
                                <option value="2">★★☆☆☆ (2 Estrellas)</option>
                                <option value="1">★☆☆☆☆ (1 Estrella)</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-white-50 small" for="comentario">Tu Experiencia</label>
                            <textarea id="comentario" name="comentario" class="form-control form-dark-control" rows="3" maxlength="500" placeholder="¿Qué tal quedó el corte?"></textarea>
                        </div>
                        <button type="submit" class="btn btn-gold-fill w-100 fw-bold">PUBLICAR RESEÑA</button>
                    </form>
                }
            </div>
        </div>

        <!-- Lista Derecha -->
        <div class="col-md-7">
            <div class="dark-card border-gold p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="text-white fw-bold mb-0">Reseñas Recientes</h4>
                    <span class="badge bg-warning text-dark">
                        @total @(total == 1 ? "Opinión" : "Opiniones")@(total > 0 ? $" · {promedio:0.0} ★" : "")
                    </span>
                </div>

                @if (total == 0)
                {
                    <p class="text-white-50 small mb-0">Aún no hay reseñas. ¡Sé el primero en calificar tu servicio!</p>
                }

                @{ var i = 0; }
                @foreach (var r in Model)
                {
                    i++;
                    <div class="@(i < total ? "border-bottom border-secondary pb-3 mb-3" : "")">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="text-white fw-bold mb-0">@NombreCorto(r.Usuario?.Nombre)</h6>
                            <span class="text-warning small">@Estrellas(r.Calificacion)</span>
                        </div>
                        <small class="text-white-50 d-block mb-2" style="font-size: 0.75rem;">
                            Atendido por: @(r.Cita?.Empleado?.Usuario?.Nombre ?? "Lumina Reserve")
                            @if (r.Fecha.HasValue) { <text> · @r.Fecha.Value.ToString("dd/MM/yyyy")</text> }
                        </small>
                        @if (!string.IsNullOrWhiteSpace(r.Comentario))
                        {
                            <p class="text-white-50 small mb-0">"@r.Comentario"</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
