@model IEnumerable<Lumina_Reserve_2.Models.Corte>
@inject Lumina_Reserve_2.Services.ImagenService Img
@{
    ViewData["Title"] = "Portafolio de Cortes";

    var tarjetas = Model
        .Select(c => new { Corte = c, Foto = Img.UrlCorte(c.Nombre) })
        .Where(x => x.Foto != null)
        .ToList();
}

<div class="container mt-5 pt-3 mb-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-white display-5 mb-2">Estilos en Tendencia por <span class="brand-gold">Lumina Reserve</span></h1>
        <p class="text-white-50">Explora nuestros trabajos. Haz clic en agendar para reservar este estilo.</p>
    </div>

    @if (tarjetas.Count == 0)
    {
        <div class="text-center text-white-50 py-5">Pronto publicaremos nuestros trabajos.</div>
    }

    <div class="row g-4">
        @foreach (var t in tarjetas)
        {
            <div class="col-md-4">
                <div class="dark-card p-3 h-100 d-flex flex-column justify-content-between border-gold">
                    <div>
                        <img src="@t.Foto" loading="lazy" class="img-fluid rounded mb-3 w-100"
                             style="height: 240px; object-fit: cover;" alt="@t.Corte.Nombre"
                             onerror="this.onerror=null;this.src='@Lumina_Reserve_2.Services.ImagenService.CortePorDefecto';">
                        <h4 class="brand-gold fw-bold mb-2">@t.Corte.Nombre</h4>
                        <p class="text-white-50 small">@(string.IsNullOrWhiteSpace(t.Corte.Descripcion) ? "Estilo disponible en Lumina Reserve." : t.Corte.Descripcion)</p>
                        <p class="text-white fw-bold mb-0">@t.Corte.Precio.ToString("C")</p>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button type="button" class="btn btn-dark-outline w-50 btn-sm" data-foto="@t.Foto" onclick="abrirImagen(this.dataset.foto)">
                            <i class="fa-solid fa-eye me-1 small"></i> Ver
                        </button>
                        <a asp-controller="Citas" asp-action="Agendar" asp-route-corte="@t.Corte.Nombre"
                           class="btn btn-gold-fill w-50 btn-sm text-uppercase fw-bold text-center">Agendar</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="modalImagenFondo" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content bg-transparent border-0">
      <div class="modal-header border-0 pb-0">
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center pt-0">
        <img id="imgExpandida" src="" class="img-fluid rounded shadow-lg" style="max-height: 80vh;" alt="Corte Expandido">
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        function abrirImagen(ruta) {
            document.getElementById('imgExpandida').src = ruta;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalImagenFondo')).show();
        }
    </script>
}